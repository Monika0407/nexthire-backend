# ==============================================================================
# NextHire Django-MySQL Module Environment Configurations
# Copy this file to '.env' at the django_backend root and replace values for production.
# ==============================================================================

# --- Django Security Credentials ---
DJANGO_SECRET_KEY="production-secret-secure-randomly-generated-key-64-bytes"
DJANGO_DEBUG="False"
ALLOWED_HOSTS="nexthire.net,www.nexthire.net,localhost,127.0.0.1"

# --- Relational Database Connection (MySQL) ---
DB_ENGINE="django.db.backends.mysql"
DB_NAME="nexthire_placement_db"
DB_USER="nexthire_root_user"
DB_PASSWORD="SecureDbPassword9821a_2026_prod"
DB_HOST="mysql-instance-prod.c.nexthire-gcp.internal"
DB_PORT="3306"

# --- Transactional SMTP E-mail (Notifications) ---
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.sendgrid.net"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER="apikey"
EMAIL_HOST_PASSWORD="SG.sendgrid-production-api-key-here"
DEFAULT_FROM_EMAIL="alerts@nexthire.net"

# --- AI & ML Integrity Settings ---
GEMINI_API_KEY="AIzaSy-Google-Gemini-Production-API-Key"
FALLBACK_AI_MODE="False"

# --- Static & Media Assets (Cloud Storage / CDN) ---
STATIC_ROOT_PATH="/var/www/nexthire/static/"
MEDIA_ROOT_PATH="/var/www/nexthire/media/"

# --- Redis Caching layer ---
REDIS_URL="redis://127.0.0.1:6379/1"
